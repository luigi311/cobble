// Health-data chart and list components.

import { Palette } from "theme.slint";
import { DaySteps, SleepBar, NapSummary, HealthSession, SleepStats, HeartStats, HeartTrendPoint } from "types.slint";

// ─── Step bar chart ──────────────────────────────────────────────────────────

export component StepsChart inherits VerticalLayout {
    in property <[DaySteps]> model;
    in property <string> today-label;
    in property <string> avg-label;
    in property <string> delta-label;
    in property <bool> delta-positive: true;
    in-out property <int> selected-bar-start: -1;
    callback bar-tapped(int, int);

    padding: 16px; spacing: 10px;

    // Summary lines wrap independently on narrow windows.
    VerticalLayout {
        spacing: 4px;
        if root.avg-label != "": Text { wrap: word-wrap; min-width: 0px;
            text: root.avg-label;
            color: Palette.muted; font-size: 13px; vertical-alignment: center;
        }
        if root.delta-label != "": Text { wrap: word-wrap; min-width: 0px;
            text: root.delta-label;
            color: root.delta-positive ? Palette.green : Palette.red;
            font-size: 13px; font-weight: 600; vertical-alignment: center;
        }
    }

    Rectangle {
        background: Palette.surface; border-radius: 12px; height: 200px; clip: true;
        steps-plot := Flickable {
            // Weekly overviews fit; dense hourly samples keep distinct touch targets.
            content-width: max(self.width, (root.model.length > 7 ? root.model.length * 52px + 24px : 0px));
            content-height: self.height;
            HorizontalLayout {
                width: steps-plot.content-width; height: steps-plot.height;
                spacing: 4px; padding: 14px;
                for day in model: Rectangle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        Rectangle { vertical-stretch: 1; }
                        Rectangle {
                            background: (root.selected-bar-start == -1 || root.selected-bar-start == day.bar-start)
                                ? Palette.accent : #4a9eff30;
                            border-radius: 3px;
                            height: max(4px, day.fraction * 148px);
                            animate background { duration: 150ms; easing: ease-in-out; }
                        }
                        Text { wrap: word-wrap; min-width: 0px;
                            text: day.label; color: Palette.muted; font-size: 11px;
                            horizontal-alignment: center; height: 18px;
                        }
                    }
                    TouchArea {
                        width: parent.width; height: parent.height;
                        clicked => {
                            if root.selected-bar-start == day.bar-start {
                                root.selected-bar-start = -1;
                                root.bar-tapped(-1, -1);
                            } else {
                                root.selected-bar-start = day.bar-start;
                                root.bar-tapped(day.bar-start, day.bar-end);
                            }
                        }
                    }
                }
            }
        }
    }
    if (root.model.length > 7 ? root.model.length * 52px + 24px : 0px) > root.width - 32px: Text { min-width: 0px;
        text: "Swipe chart sideways · Tap a bar for details"; color: Palette.muted; font-size: 11px; wrap: word-wrap;
    }
}

// ─── Combined sleep and nap chart ────────────────────────────────────────────

export component SleepChart inherits VerticalLayout {
    in property <[SleepBar]> model;
    in property <[SleepBar]> nap-model;
    in property <bool> has-sleep;
    in property <bool> has-naps;
    in property <string> max-label;
    in property <string> mid-label;
    in property <string> avg-label;
    in property <string> delta-label;
    in property <bool> delta-positive: true;
    in property <bool> weekly-averages;
    in-out property <int> selected-bar-start: -1;
    callback bar-tapped(int, int);
    in-out property <int> selected-index: -1;
    property <int> detail-index: root.model.length == 1 ? 0 : root.selected-index;
    changed selected-bar-start => {
        if root.selected-bar-start == -1 { root.selected-index = -1; }
    }

    padding: 16px; spacing: 12px;

    Text { wrap: word-wrap; min-width: 0px; text: "Sleep + naps"; color: Palette.muted; font-size: 11px; }
    VerticalLayout {
        spacing: 4px;
        Text { wrap: word-wrap; min-width: 0px; text: root.avg-label; color: Palette.text; font-size: 16px; font-weight: 600; }
        if root.delta-label != "": Text { wrap: word-wrap; min-width: 0px;
            text: root.delta-label;
            color: root.delta-positive ? Palette.green : Palette.red;
            font-size: 13px; font-weight: 600; vertical-alignment: center;
        }
    }
    if root.weekly-averages: Text { min-width: 0px;
        text: "Weekly bars average days with recorded sleep or naps.";
        color: Palette.muted; font-size: 11px; wrap: word-wrap;
    }

    Rectangle {
        background: Palette.surface; border-radius: 12px; height: 220px; clip: true;
        sleep-plot := Flickable {
            content-width: max(self.width, (root.model.length > 7 ? root.model.length * 56px + 68px : 0px));
            content-height: self.height;
            HorizontalLayout {
                width: sleep-plot.content-width; height: sleep-plot.height;
                padding: 12px; spacing: 8px;
                VerticalLayout {
                    width: 44px; padding-top: 14px; padding-bottom: 22px;
                    Text { wrap: word-wrap; min-width: 0px; text: root.max-label; color: Palette.muted; font-size: 11px; }
                    Rectangle { vertical-stretch: 1; }
                    Text { wrap: word-wrap; min-width: 0px; text: root.mid-label; color: Palette.muted; font-size: 11px; }
                    Rectangle { vertical-stretch: 1; }
                    Text { wrap: word-wrap; min-width: 0px; text: "0m"; color: Palette.muted; font-size: 11px; }
                }
                for night[index] in root.model: Rectangle {
                    horizontal-stretch: 1;
                    opacity: root.selected-bar-start == -1 || root.selected-bar-start == night.bar-start ? 1 : 0.3;
                    animate opacity { duration: 150ms; easing: ease-in-out; }
                    VerticalLayout {
                        spacing: 4px;
                        VerticalLayout {
                            Rectangle { vertical-stretch: 1; }
                            Rectangle {
                                background: Palette.light-nap;
                                height: root.nap-model[index].light-fraction * 160px;
                            }
                            Rectangle {
                                background: Palette.deep-nap;
                                height: root.nap-model[index].deep-fraction * 160px;
                            }
                            Rectangle {
                                background: Palette.accent;
                                height: night.light-fraction * 160px;
                            }
                            Rectangle {
                                background: Palette.deep-sleep;
                                height: night.deep-fraction * 160px;
                                border-radius: 2px;
                            }
                        }
                        Text { wrap: word-wrap; min-width: 0px;
                            text: night.label; color: Palette.muted; font-size: 11px;
                            horizontal-alignment: center; height: 18px;
                        }
                    }
                    TouchArea {
                        clicked => {
                            if root.selected-bar-start == night.bar-start {
                                root.selected-bar-start = -1;
                                root.bar-tapped(-1, -1);
                            } else {
                                root.selected-index = index;
                                root.selected-bar-start = night.bar-start;
                                root.bar-tapped(night.bar-start, night.bar-end);
                            }
                        }
                    }
                }
            }
        }
        if !root.has-sleep && !root.has-naps: Text { wrap: word-wrap; min-width: 0px;
            text: "No sleep or naps in this period";
            color: Palette.muted; font-size: 12px;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    if (root.model.length > 7 ? root.model.length * 56px + 68px : 0px) > root.width - 32px: Text { min-width: 0px;
        text: "Swipe chart sideways · Tap a bar for details"; color: Palette.muted; font-size: 11px; wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 4px;
            Text { wrap: word-wrap; min-width: 0px; text: "Sleep"; color: Palette.text; font-size: 12px; font-weight: 600; }
            HorizontalLayout {
                spacing: 4px;
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: Palette.accent; y: 3px; }
                Text { wrap: word-wrap; min-width: 0px; text: "Light"; color: Palette.muted; font-size: 11px; }
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: Palette.deep-sleep; y: 3px; }
                Text { wrap: word-wrap; min-width: 0px; text: "Deep"; color: Palette.muted; font-size: 11px; }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Text { wrap: word-wrap; min-width: 0px; text: "Naps"; color: Palette.text; font-size: 12px; font-weight: 600; }
            HorizontalLayout {
                spacing: 4px;
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: Palette.light-nap; y: 3px; }
                Text { wrap: word-wrap; min-width: 0px; text: "Light"; color: Palette.muted; font-size: 11px; }
                Rectangle { width: 8px; height: 8px; border-radius: 2px; background: Palette.deep-nap; y: 3px; }
                Text { wrap: word-wrap; min-width: 0px; text: "Deep"; color: Palette.muted; font-size: 11px; }
            }
        }
    }
    if root.detail-index >= 0 && root.detail-index < root.model.length: HorizontalLayout {
        Text { wrap: word-wrap; min-width: 0px;
            text: (root.weekly-averages ? "Avg sleep: " : "Sleep: ") + root.model[root.detail-index].total-label;
            color: Palette.accent; font-size: 12px;
        }
        Rectangle { horizontal-stretch: 1; }
        Text { wrap: word-wrap; min-width: 0px;
            text: (root.weekly-averages ? "Avg naps: " : "Naps: ") + root.nap-model[root.detail-index].total-label;
            color: Palette.light-nap; font-size: 12px;
        }
    }
}

component NapMetric inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    min-width: 0px;
    horizontal-stretch: 1;
    spacing: 4px;
    Text { text: root.value; color: Palette.light-nap; font-size: 14px; font-weight: 700; overflow: elide; }
    Text { text: root.label; color: Palette.text; font-size: 11px; overflow: elide; }
}

export component NapSummaryCard inherits VerticalLayout {
    in property <NapSummary> summary;
    padding-left: 16px; padding-right: 16px; padding-bottom: 12px;
    Rectangle {
        background: Palette.surface; border-radius: 12px;
        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { wrap: word-wrap; min-width: 0px; text: "Naps"; color: Palette.text; font-size: 15px; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.summary.scope-label; color: Palette.text; font-size: 11px; wrap: word-wrap; horizontal-alignment: right; }
            }
            if root.summary.available && root.summary.count > 0: HorizontalLayout {
                spacing: 8px;
                NapMetric { value: "" + root.summary.count; label: "Naps"; }
                NapMetric { value: root.summary.total-label; label: "Total time"; }
                NapMetric { value: root.summary.avg-label; label: "Avg nap"; }
            }
            if !root.summary.available || root.summary.count == 0: Text { min-width: 0px;
                text: root.summary.available ? "No naps recorded in these dates." : "Nap summary unavailable.";
                color: Palette.text; font-size: 13px; wrap: word-wrap;
            }
            if root.summary.available && root.summary.latest-label != "": Text { min-width: 0px;
                text: root.summary.latest-label;
                color: Palette.text; font-size: 12px; wrap: word-wrap;
            }
        }
    }
}

// ─── Session list ─────────────────────────────────────────────────────────────

export component SessionList inherits VerticalLayout {
    in property <[HealthSession]> model;
    alignment: start; spacing: 8px;
    padding-left: 16px; padding-right: 16px; padding-bottom: 16px;
    if root.model.length == 0: Text {
        text: "No activity recorded in this period."; color: Palette.muted; font-size: 13px;
        wrap: word-wrap; horizontal-alignment: center;
    }
    for s in root.model: Rectangle {
        min-height: s.has-metrics ? 108px : 80px;
        background: Palette.surface; border-radius: 10px;
        VerticalLayout {
            padding: 12px; spacing: 4px;
            Text { text: s.type-name; color: Palette.text; font-size: 14px; font-weight: 600; wrap: word-wrap; }
            Text { text: s.start-label; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
            Text { text: s.duration-label; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
            if s.has-metrics: Text { text: s.metrics-label; color: Palette.accent; font-size: 12px; wrap: word-wrap; }
        }
    }
}

// ─── Sleep stats panel ───────────────────────────────────────────────────────

export component SleepStatsPanel inherits VerticalLayout {
    in property <SleepStats> stats;

    vertical-stretch: 0;
    padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 16px;
    spacing: 10px;

    // Header: title
    HorizontalLayout {
        Text { wrap: word-wrap; min-width: 0px; text: "Key Stats"; color: Palette.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }

    // Stats grid
    Rectangle {
        background: Palette.surface; border-radius: 12px;
        VerticalLayout {
            padding: 14px; spacing: 10px;

            // Row 1: Deep Sleep Avg | Stage Mix
            HorizontalLayout {
                spacing: 10px;
                // Deep sleep average
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Avg Deep Sleep"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px;
                            text: root.stats.deep-avg-label;
                            color: Palette.deep-sleep;
                            font-size: 18px; font-weight: 700;
                        }
                    }
                }
                // Stage mix
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Stage Mix"; color: Palette.muted; font-size: 11px; }
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 3px;
                                Text { wrap: word-wrap; min-width: 0px; text: "" + round(root.stats.light-pct) + "%"; color: Palette.accent; font-size: 14px; font-weight: 700; }
                                Text { wrap: word-wrap; min-width: 0px; text: "light"; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 3px;
                                Text { wrap: word-wrap; min-width: 0px; text: "" + round(root.stats.deep-pct) + "%"; color: Palette.deep-sleep; font-size: 14px; font-weight: 700; }
                                Text { wrap: word-wrap; min-width: 0px; text: "deep"; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
                            }
                            if root.stats.awake-pct > 0: HorizontalLayout {
                                spacing: 3px;
                                Text { wrap: word-wrap; min-width: 0px; text: "" + round(root.stats.awake-pct) + "%"; color: Palette.muted; font-size: 14px; font-weight: 700; }
                                Text { wrap: word-wrap; min-width: 0px; text: "awake"; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Row 2: Avg Bedtime | Avg Wakeup
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Avg Bedtime"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.avg-bedtime; color: Palette.text; font-size: 16px; font-weight: 600; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Avg Wake-up"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.avg-wakeup; color: Palette.text; font-size: 16px; font-weight: 600; }
                    }
                }
            }

            // Row 3: Highest | Lowest duration
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Longest Night"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.highest-dur; color: Palette.green; font-size: 16px; font-weight: 600; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Shortest Night"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.lowest-dur; color: Palette.orange; font-size: 16px; font-weight: 600; }
                    }
                }
            }
        }
    }
}

// ─── Heart-rate trend chart ──────────────────────────────────────────────────

export component HeartTrendChart inherits VerticalLayout {
    in property <[HeartTrendPoint]> model;
    in property <string> average-path;
    in property <string> resting-path;
    in property <string> max-label;
    in property <string> mid-label;
    in property <string> min-label;
    in property <bool> has-data: false;

    Rectangle {
        background: Palette.surface; border-radius: 12px; height: 286px; clip: true;
        VerticalLayout {
            padding: 14px; spacing: 8px;

            VerticalLayout {
                spacing: 8px;
                Text { wrap: word-wrap; min-width: 0px; text: "Heart Rate Trend"; color: Palette.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle { width: 14px; height: 2px; background: Palette.red; y: 5px; }
                        Text { wrap: word-wrap; min-width: 0px; text: "Average"; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle { width: 14px; height: 2px; background: Palette.accent; y: 5px; }
                        Text { wrap: word-wrap; min-width: 0px; text: "Resting"; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }

            if root.has-data: VerticalLayout {
                vertical-stretch: 1; spacing: 4px;
                HorizontalLayout {
                    height: 158px;
                    VerticalLayout {
                        width: 38px;
                        Text { wrap: word-wrap; min-width: 0px; text: root.max-label; color: Palette.muted; font-size: 11px; vertical-alignment: top; }
                        Rectangle { vertical-stretch: 1; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.mid-label; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
                        Rectangle { vertical-stretch: 1; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.min-label; color: Palette.muted; font-size: 11px; vertical-alignment: bottom; }
                    }
                    Rectangle {
                        horizontal-stretch: 1; clip: true;
                        // Three quiet guide lines keep the shared BPM scale easy to read.
                        Path {
                            width: parent.width; height: parent.height;
                            commands: "M 0 0 L 100 0 M 0 50 L 100 50 M 0 100 L 100 100";
                            viewbox-width: 100; viewbox-height: 100;
                            fit: fill;
                            fill: #00000000; stroke: #6a6a9040; stroke-width: 1px;
                        }
                        if root.average-path != "": Path {
                            width: parent.width; height: parent.height;
                            commands: root.average-path;
                            viewbox-width: 100; viewbox-height: 100;
                            fit: fill;
                            fill: #00000000; stroke: Palette.red; stroke-width: 2px;
                            stroke-line-cap: round; stroke-line-join: round;
                        }
                        if root.resting-path != "": Path {
                            width: parent.width; height: parent.height;
                            commands: root.resting-path;
                            viewbox-width: 100; viewbox-height: 100;
                            fit: fill;
                            fill: #00000000; stroke: Palette.accent; stroke-width: 2px;
                            stroke-line-cap: round; stroke-line-join: round;
                        }

                    }
                }
                Rectangle {
                    height: 18px; clip: true;
                    // Day has 24 cells, but only four hour labels. Do not wrap
                    // a label into its narrow cell or let it change chart height.
                    for point[index] in root.model: Text {
                        x: 38px + (parent.width - 38px) * (index + 0.5) / root.model.length - self.width / 2;
                        width: 44px; height: parent.height;
                        text: point.label; color: Palette.muted; font-size: 11px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
            if !root.has-data: Rectangle {
                vertical-stretch: 1;
                Text { wrap: word-wrap; min-width: 0px; text: "No heart-rate trend data for this period"; color: Palette.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

// ─── Heart-rate stats panel ──────────────────────────────────────────────────

export component HeartStatsPanel inherits VerticalLayout {
    in property <HeartStats> stats;
    in property <[HeartTrendPoint]> trend-model;
    in property <string> average-path;
    in property <string> resting-path;
    in property <string> trend-max-label;
    in property <string> trend-mid-label;
    in property <string> trend-min-label;
    in property <bool> trend-has-data: false;

    vertical-stretch: 0;
    padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 16px;
    spacing: 10px;

    HeartTrendChart {
        model: root.trend-model;
        average-path: root.average-path;
        resting-path: root.resting-path;
        max-label: root.trend-max-label;
        mid-label: root.trend-mid-label;
        min-label: root.trend-min-label;
        has-data: root.trend-has-data;
    }

    HorizontalLayout {
        Text { wrap: word-wrap; min-width: 0px; text: "Key Stats"; color: Palette.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }

    Rectangle {
        background: Palette.surface; border-radius: 12px;
        VerticalLayout {
            padding: 14px; spacing: 10px;

            // Row 1: overall average across the full width
            Rectangle {
                horizontal-stretch: 1;
                background: #401e2a; border-radius: 8px;
                VerticalLayout {
                    padding: 10px; spacing: 4px;
                    Text { wrap: word-wrap; min-width: 0px; text: "Avg Heart Rate"; color: Palette.muted; font-size: 11px; }
                    Text { wrap: word-wrap; min-width: 0px; text: root.stats.average-label; color: Palette.red; font-size: 18px; font-weight: 700; }
                }
            }

            // Row 2: resting average | sleeping average
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Avg Resting HR"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.resting-label; color: Palette.accent; font-size: 18px; font-weight: 700; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Avg Sleeping HR"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.sleeping-label; color: Palette.deep-sleep; font-size: 18px; font-weight: 700; }
                    }
                }
            }

            // Row 3: lowest sample | highest sample
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Lowest HR"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.lowest-label; color: Palette.green; font-size: 18px; font-weight: 700; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1e1e40; border-radius: 8px;
                    VerticalLayout {
                        padding: 10px; spacing: 4px;
                        Text { wrap: word-wrap; min-width: 0px; text: "Highest HR"; color: Palette.muted; font-size: 11px; }
                        Text { wrap: word-wrap; min-width: 0px; text: root.stats.highest-label; color: Palette.orange; font-size: 18px; font-weight: 700; }
                    }
                }
            }
        }
    }
}
